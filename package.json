{
    "name": "@bric/rex-history",
    "version": "0.0.1",
    "description": "REX module for collecting browser history data via Chrome History API.",
    "keywords": [
        "extension",
        "rex",
        "history",
        "browsing-data"
    ],
    "author": "Behavioral Research Innovation Center",
    "type": "module",
    "homepage": "https://github.com/bric-digital/rex-history",
    "bugs": {
        "url": "https://github.com/bric-digital/rex-history/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bric-digital/rex-history.git"
    },
    "exports": {
        "./extension": "./src/extension.mts",
        "./browser": "./src/browser.mts",
        "./service-worker": "./src/service-worker.mts"
    },
    "scripts": {
        "build": "tsc",
        "lint": "eslint src",
        "pretest": "node tests/scripts/build-test-bundle.js",
        "test": "playwright test",
        "test:ci": "playwright test --reporter=dot",
        "test:debug": "playwright test --debug",
        "test:headed": "playwright test --headed",
        "test:ui": "playwright test --ui",
        "test:unit": "playwright test specs/",
        "test:legacy": "node --test"
    },
    "dependencies": {
        "@bric/rex-core": "github:bric-digital/rex-core",
        "@bric/rex-lists": "github:bric-digital/rex-lists#a9c38eb04072a224aaf6963d89989e4acbc8ef95",
        "@bric/rex-types": "github:bric-digital/rex-types",
        "@types/node": "^25.7.0",
        "psl": "^1.9.0"
    }
}
